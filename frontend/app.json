{
  "expo": {
    "name": "RPS Strategy",
    "slug": "rps-strategy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#211f1d",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.henhen1227.rps-strategy",
      "associatedDomains": [
        "applinks:rps.henhen1227.com"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
