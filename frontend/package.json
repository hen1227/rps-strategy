{
  "name": "frontend",
  "version": "1.0.0",
  "license": "AGPL-3.0-or-later",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.11",
    "@types/react": "~19.2.4",
    "expo": "~57.0.14",
    "expo-asset": "~57.0.16",
    "expo-audio": "~57.0.3",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.13",
    "expo-device": "~57.0.1",
    "expo-linking": "~57.0.7",
    "expo-notifications": "~57.0.14",
    "expo-router": "~57.0.15",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "typescript": "~6.0.3",
    "zustand": "^5.0.15"
  },
  "scripts": {
    "start": "npm run build:worker && expo start",
    "android": "expo run:android",
    "ios": "npm run build:rpsfish:ios && expo run:ios --device",
    "web": "npm run build:worker && expo start --web",
    "typecheck": "tsc --noEmit",
    "build:worker": "esbuild src/engine/rpsfish/worker/index.ts --bundle --format=iife --target=es2022 --outfile=public/rpsfish/rpsfish-worker.js --tsconfig=tsconfig.json",
    "build:rpsfish": "./scripts/build-engine.sh web",
    "build:rpsfish:ios": "./scripts/build-engine.sh ios",
    "arena": "node --import ./scripts/register.mjs scripts/botArena.mts",
    "calibrate:review": "node --import ./scripts/register.mjs scripts/reviewCalibration.mts",
    "measure:stability": "node --import ./scripts/register.mjs scripts/reviewStability.mts",
    "licences": "node --import ./scripts/register.mjs scripts/licences.mts",
    "pretest": "npm run build:worker",
    "test": "tsc --noEmit && node --import ./scripts/register.mjs --test \"src/**/*.test.mts\"",
    "test:watch": "node --import ./scripts/register.mjs --test --watch \"src/**/*.test.mts\"",
    "prebuild:web": "npm run build:rpsfish && npm run build:worker",
    "build:web": "expo export -p web --clear",
    "predeploy": "npm run build:web",
    "deploy": "gh-pages --nojekyll --remove '{**/*,.claude/**/*,.gitignore,.nojekyll}' -d dist -b dist"
  },
  "private": true,
  "devDependencies": {
    "@types/node": "^26.2.0",
    "esbuild": "^0.28.2",
    "gh-pages": "^6.3.0"
  }
}
