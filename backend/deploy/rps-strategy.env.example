RPS_UNIX_SOCKET=/var/www/production/henhen1227/rps-henhen1227-backend.sock
RPS_DATABASE_PATH=/var/www/production/henhen1227/api-rps.henhen1227.com/rps-strategy.sqlite
RPS_ALLOWED_ORIGINS=https://rps.henhen1227.com
RPS_ADMIN_TOKEN=replace-with-a-random-token-containing-at-least-32-characters

# Optional. The canonical address to publish in the absolute download links the
# bot client and its guide page hand people. Left unset, those links are built
# from the address each request arrived on (nginx passes Host and
# X-Forwarded-Proto), which is right whenever there is only one way in. Set it
# when there is more than one and you want them all pointing at this name.
RPS_PUBLIC_URL=https://api-rps.henhen1227.com

# Discord sign-in. Creating an account needs these: without them the sign-in
# route answers 503 and nobody new can join, so this is the one block worth
# checking before a first deploy. Accounts that still hold a password keep
# working either way. All four are required together — half-configured is
# refused and logged rather than quietly disabled, as with the two blocks below.
#
# Register an application at https://discord.com/developers/applications, then
# add the redirect below under OAuth2. Only the `identify` scope is used: no bot
# user, no guild, no server membership check.
#
# RPS_DISCORD_REDIRECT_URL points at *this* API host and not at the site. The
# backend does the code exchange, so Discord comes back here and the browser is
# sent on afterwards. It must match the portal entry exactly, character for
# character, which is also why it is set explicitly rather than derived from the
# Host header a request happened to arrive on.
RPS_DISCORD_CLIENT_ID=
RPS_DISCORD_CLIENT_SECRET=
RPS_DISCORD_REDIRECT_URL=https://api-rps.henhen1227.com/api/auth/discord/callback

# Where a finished sign-in may send the browser, comma separated. This is an
# allowlist and it is the open-redirect guard: a return address is matched
# against it when the sign-in starts, and the callback only ever uses the one it
# stored. Anything not listed here is refused.
#
# It cannot default to RPS_ALLOWED_ORIGINS, which is a CORS list: the iOS app
# comes back to its own URL scheme, which is not an HTTP origin at all. Add the
# development addresses here too, or the flow cannot be run locally.
RPS_DISCORD_RETURN_URLS=https://rps.henhen1227.com,rps-strategy://account/callback

# Web Push. These three are what let somebody wait in the queue with the tab
# closed: without them the server cannot call a *browser* back, so it says so,
# the web app hides the offer, and matchmaking behaves exactly as it did before
# the persistent queue existed. Half-configured is refused and logged rather
# than quietly disabled.
#
# Generate a key pair with:
#   go run ./cmd/vapidkeys
#
# The subject identifies you to the push services, and must be a mailto: or an
# https URL they can reach a human at.
RPS_VAPID_PUBLIC_KEY=
RPS_VAPID_PRIVATE_KEY=
RPS_VAPID_SUBJECT=mailto:you@example.com

# APNs, which is the same promise kept for the iOS app. Independent of the three
# above: a deployment can have either, both or neither, and each client is told
# only about its own transport. Half-configured is refused and logged here too.
#
# The key is the Apple Push Notification service key from Apple Developer ->
# Keys, downloaded once as a .p8. Keep it out of the repository — .p8 is
# gitignored — and readable only by the service user.
#
#   scp AuthKey_ABCD123456.p8 orange-pi:/tmp/
#   sudo install -o rps -g rps -m 600 /tmp/AuthKey_ABCD123456.p8 /etc/rps/
#
# RPS_APNS_KEY_ID is the .p8 filename minus the AuthKey_ prefix.
RPS_APNS_KEY_PATH=
RPS_APNS_KEY_ID=
RPS_APNS_TEAM_ID=

# Optional. Defaults to the app's bundle id, which is what APNs calls a topic.
#RPS_APNS_TOPIC=com.henhen1227.rps-strategy

# Optional, and the one to get right. A device token minted by a debug build
# exists only in Apple's sandbox, and the production host answers it with
# BadDeviceToken — which looks identical to a working setup that never delivers.
# Set this on a development machine; leave it unset for the shipped app.
#RPS_APNS_ENVIRONMENT=sandbox

# The RPS Lab's agent. With a key here the Lab's chat runs on this server, so a
# visitor with no OpenAI account can design a game; without one the Lab offers to
# use a key the visitor pastes, which is sent straight to OpenAI and never here.
# Either way the page's WebMCP tools are what actually get called.
#
# RPS_OPENAI_MODEL defaults to gpt-5.6-terra. RPS_OPENAI_BASE_URL points the
# relay at an OpenAI-compatible endpoint instead — a gateway, or a scripted one
# while developing the Lab without spending anything.
RPS_OPENAI_API_KEY=
RPS_OPENAI_MODEL=
RPS_OPENAI_BASE_URL=
