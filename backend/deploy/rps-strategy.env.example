RPS_UNIX_SOCKET=/var/www/production/henhen1227/rps-henhen1227-backend.sock
RPS_DATABASE_PATH=/var/www/production/henhen1227/api-rps.henhen1227.com/rps-strategy.sqlite
RPS_ALLOWED_ORIGINS=https://rps.henhen1227.com
RPS_ADMIN_TOKEN=replace-with-a-random-token-containing-at-least-32-characters

# Optional. The canonical address to publish in the absolute download links the
# bot client and its guide page hand people. Left unset, those links are built
# from the address each request arrived on (nginx passes Host and
# X-Forwarded-Proto), which is right whenever there is only one way in. Set it
# when there is more than one and you want them all pointing at this name.
RPS_PUBLIC_URL=https://api-rps.henhen1227.com

# Discord sign-in. Creating an account needs these: without them the sign-in
# route answers 503 and nobody new can join, so this is the one block worth
# checking before a first deploy. Accounts that still hold a password keep
# working either way. All four are required together — half-configured is
# refused and logged rather than quietly disabled, as with the two blocks below.
#
# Register an application at https://discord.com/developers/applications, then
# add the redirect below under OAuth2. Only the `identify` scope is used: no bot
# user, no guild, no server membership check.
#
# RPS_DISCORD_REDIRECT_URL points at *this* API host and not at the site. The
# backend does the code exchange, so Discord comes back here and the browser is
# sent on afterwards. It must match the portal entry exactly, character for
# character, which is also why it is set explicitly rather than derived from the
# Host header a request happened to arrive on.
RPS_DISCORD_CLIENT_ID=
RPS_DISCORD_CLIENT_SECRET=
RPS_DISCORD_REDIRECT_URL=https://api-rps.henhen1227.com/api/auth/discord/callback

# Where a finished sign-in may send the browser, comma separated. This is an
# allowlist and it is the open-redirect guard: a return address is matched
# against it when the sign-in starts, and the callback only ever uses the one it
# stored. Anything not listed here is refused.
#
# It cannot default to RPS_ALLOWED_ORIGINS, which is a CORS list: the iOS app
# comes back to its own URL scheme, which is not an HTTP origin at all. Add the
# development addresses here too, or the flow cannot be run locally.
#
# The app entry is the bare scheme rather than a path, and that matters. Entries
# are matched as prefixes, and the address the app sends is built by Expo's
# `Linking.createURL`, which returns rps-strategy:///account/callback -- three
# slashes, because the host part of the URL is empty. Listing the two-slash path
# instead looks right, matches nothing the client can produce, and fails as
# "that return address is not allowed" on native only, long after the web flow
# has been seen working.
RPS_DISCORD_RETURN_URLS=https://rps.henhen1227.com,rps-strategy://

# Web Push. These three are what let somebody wait in the queue with the tab
# closed: without them the server cannot call a *browser* back, so it says so,
# the web app hides the offer, and matchmaking behaves exactly as it did before
# the persistent queue existed. Half-configured is refused and logged rather
# than quietly disabled.
#
# Generate a key pair with:
#   go run ./cmd/vapidkeys
#
# The subject identifies you to the push services, and must be a mailto: or an
# https URL they can reach a human at.
RPS_VAPID_PUBLIC_KEY=
RPS_VAPID_PRIVATE_KEY=
RPS_VAPID_SUBJECT=mailto:you@example.com

# APNs, which is the same promise kept for the iOS app. Independent of the three
# above: a deployment can have either, both or neither, and each client is told
# only about its own transport. Half-configured is refused and logged here too.
#
# The key is the Apple Push Notification service key from Apple Developer ->
# Keys, downloaded once as a .p8. Keep it out of the repository — .p8 is
# gitignored — and readable only by root and the service, which runs as
# www-data (see rps-strategy.service). Not under /tmp or a home directory: the
# unit gives the service a private /tmp and no view of /home.
#
#   scp AuthKey_ABCD123456.p8 server2:/tmp/
#   sudo install -d -o root -g www-data -m 0750 /etc/rps-strategy
#   sudo install -o root -g www-data -m 0640 /tmp/AuthKey_ABCD123456.p8 /etc/rps-strategy/
#   rm /tmp/AuthKey_ABCD123456.p8
#
# RPS_APNS_KEY_ID is the .p8 filename minus the AuthKey_ prefix.
RPS_APNS_KEY_PATH=
RPS_APNS_KEY_ID=
RPS_APNS_TEAM_ID=

# Optional. Defaults to the app's bundle id, which is what APNs calls a topic.
#RPS_APNS_TOPIC=com.henhen1227.rps-strategy

# Optional, and the one to get right. A device token minted by a debug build
# exists only in Apple's sandbox, and the production host answers it with
# BadDeviceToken — which looks identical to a working setup that never delivers.
# Set this on a development machine; leave it unset for the shipped app.
#RPS_APNS_ENVIRONMENT=sandbox

# FCM, the same promise kept for the Android app. Independent of the blocks
# above, and each client is told only about its own transport.
#
# The credentials are a service account key for the Firebase project the app's
# google-services.json belongs to: Firebase console -> Project settings ->
# Service accounts -> Generate new private key, downloaded once as JSON. The two
# must be the same project, or every send fails with SENDER_ID_MISMATCH. Install
# it like the APNs key: root:www-data, mode 0640, under /etc/rps-strategy.
#
#   scp rps-firebase.json server2:/tmp/
#   sudo install -o root -g www-data -m 0640 /tmp/rps-firebase.json /etc/rps-strategy/
#   rm /tmp/rps-firebase.json
#
# With it unset, Android phones are not offered match alerts. A file that cannot
# be read or parsed is logged at boot and leaves Android off.
RPS_FCM_CREDENTIALS_PATH=

# Sign in with Apple. The phone's sign-in needs the three below; the website's
# needs the Services ID block after them as well. With no key, Apple is not
# offered anywhere — the app asks /api/auth/providers before it shows the
# button — and half-configured is refused and logged, as above.
#
# The key is a Sign in with Apple key from Apple Developer -> Keys, configured
# with com.henhen1227.rps-strategy as its primary App ID and downloaded once as
# a .p8. A key of its own rather than the APNs one, so either can be revoked
# without breaking the other. Install it beside the APNs key, the same way:
#
#   scp AuthKey_KEYID.p8 server2:/tmp/
#   sudo install -o root -g www-data -m 0640 /tmp/AuthKey_KEYID.p8 /etc/rps-strategy/
#   rm /tmp/AuthKey_KEYID.p8
#
# RPS_APPLE_KEY_ID is the .p8 filename minus the AuthKey_ prefix. The team ID
# is the ten characters on Apple Developer -> Membership; left empty, it is
# RPS_APNS_TEAM_ID's. At boot the server asks Apple whether it accepts the key
# and logs the answer, so check the log after setting these.
RPS_APPLE_KEY_PATH=
RPS_APPLE_KEY_ID=
RPS_APPLE_TEAM_ID=

# Optional. Defaults to the app's bundle id, which is the client Apple issues
# the phone's sign-in to.
#RPS_APPLE_BUNDLE_ID=com.henhen1227.rps-strategy

# Sign in with Apple on the website: a Services ID grouped under the app's App
# ID, and the return URL registered on it, which points at this API host the
# way Discord's does. Apple accepts only an https return URL on a real host, so
# the website's Apple sign-in cannot be run against localhost. Leave both out
# for the phone alone.
#RPS_APPLE_SERVICES_ID=com.henhen1227.rps-strategy.web
#RPS_APPLE_REDIRECT_URL=https://api-rps.henhen1227.com/api/auth/apple/callback

# Optional. Where the website's Apple sign-in may send the browser back to.
# Defaults to RPS_DISCORD_RETURN_URLS, which lists the same pages.
#RPS_APPLE_RETURN_URLS=

# Google Analytics. Optional, and off when unset. These two let the server do
# the half of analytics no browser tag can: forward the iOS and Android apps'
# events (POST /api/analytics), and report finished games and engines coming
# online. Both are needed together; half-configured is refused and logged.
#
# The measurement ID is the web data stream's (Admin -> Data streams), the same
# G- ID the website is built with in frontend/.env.production. The secret is
# created on that stream under Measurement Protocol API secrets. Keep it here,
# never in the frontend: the app and the site are public source.
# See docs/analytics.md.
RPS_GA_MEASUREMENT_ID=
RPS_GA_API_SECRET=
