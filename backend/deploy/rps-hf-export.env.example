# Configuration for the daily Hugging Face export, installed on the server as
#
#   /var/www/production/henhen1227/api-rps.henhen1227.com/export/export.env
#
# Deliberately separate from the server's own .env. Nothing here is needed by
# the game server, and two of these are secrets it should not be holding: it has
# no use for a Hugging Face write token, and this job has no use for the admin
# token. Because the export reads SQLite directly rather than calling the API,
# it needs no admin credential at all.
#
# Same rules as the server's .env: plain KEY=value, no `export`, mode 0640 owned
# so www-data can read it, and read by systemd at unit start — editing it does
# not reach a run already in flight.

# The archive to publish, opened read-only. The same file the server writes, and
# the same value as RPS_DATABASE_PATH in the server's .env.
RPS_DATABASE_PATH=/var/www/production/henhen1227/api-rps.henhen1227.com/rps-strategy.sqlite

# The secret the published per-player keys are derived from.
#
# This is the one setting that must never leak and must never change. Account
# ids are public — /api/accounts/{userID} serves them unauthenticated — so a
# plain hash of one could be reversed by anybody who scrapes the leaderboard and
# hashes what they find. HMAC under a private key is what makes the published
# key opaque, and this is that key.
#
# Losing it is not recoverable: every future file would group players
# differently from every past one, with no way to reconcile them. Back it up
# with the ledger. Generate one with:
#
#   openssl rand -hex 32
#
# The export refuses to run if this is unset rather than falling back to
# publishing raw ids.
RPS_EXPORT_KEY_SECRET=replace-with-openssl-rand-hex-32

# The dataset being published to.
RPS_EXPORT_HF_REPO=Henhen1227/rps-strategy-games

# A Hugging Face access token with write permission, scoped to that one dataset
# repository and nothing else. Create it as a fine-grained token at
# https://huggingface.co/settings/tokens — a token that can only write one
# dataset is a token whose loss costs one dataset.
HF_TOKEN=replace-with-a-fine-grained-write-token

# Optional. Account ids that have asked to stay out of the data set, comma
# separated. PRIVACY.md offers this in as many words: "message me and I'll leave
# you out of future files."
#
# Their games are still published — a game belongs to two people, and dropping
# it would put a hole in the opponent's record — but both of that player's seats
# read "Anonymous player" instead of their username, in every file written from
# then on. Files already published cannot be changed.
#
# These are account ids, not usernames, deliberately: a username match would
# silently start or stop applying when somebody renames themselves, which is the
# one way this list must not fail. Look an id up with:
#
#   sqlite3 -readonly rps-strategy.sqlite \
#     "SELECT user_id FROM accounts WHERE username = 'their-name'"
#
# RPS_EXPORT_EXCLUDE=
